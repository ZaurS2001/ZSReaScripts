desc: RAQUD - Random Quantized MIDI Generator
author: ZaurS2001
version: 1.6.3
about:
  # RAQUD
  A professional-grade random MIDI generator with integrated quantization.
  - 100% eliminated GUI flicker (Optimized CPU & UI thread).
  - Perfect immediate playback on transport start.
  - Smoothly scrolling DAW-style MIDI Timeline visualizer.
changelog:
  - CRITICAL FIX: Rewrote Sync Engine to an absolute "Integer Grid Tracker". Flawlessly triggers the exact microsecond transport starts. (v1.6.3)
  - Fixed "First note muted" bug (Removed internal CC 123 race condition, again...).
  - Fixed visualizer "Ghost Notes" by instantly flushing the buffer on transport loops and timeline clicks.

slider1:0<0,1,1{Free (ms),Sync (Beats)}>Timing Mode
slider2:6<0,11,1{8/1,4/1,2/1,1/1,1/2,1/4,1/8,1/16,1/32,1/4T,1/8T,1/16T}>Sync Rate
slider3:250<10,2000,1>Free Rate (ms)
slider4:36<0,127,1>Min Note
slider5:84<0,127,1>Max Note
slider6:0<-24,24,1>Tune / Transpose (st)
slider7:50<5,100,1>Gate Length (%)
slider8:2<0,12,1{Custom,Chromatic,Major,Minor,Pentatonic Maj,Pentatonic Min,Dorian,Phrygian,Lydian,Mixolydian,Locrian,Harmonic Minor,Melodic Minor}>Scale Preset
slider9:0<0,1,1{Off,On}>Chord Mode
slider22:3<2,7,1>Keys per Chord

// Hidden sliders used for state saving and automation of the 12 piano keys
slider10:1<0,1,1>-C
slider11:1<0,1,1>-C#
slider12:1<0,1,1>-D
slider13:1<0,1,1>-D#
slider14:1<0,1,1>-E
slider15:1<0,1,1>-F
slider16:1<0,1,1>-F#
slider17:1<0,1,1>-G
slider18:1<0,1,1>-G#
slider19:1<0,1,1>-A
slider20:1<0,1,1>-A#
slider21:1<0,1,1>-B

@init
ext_noinit = 1; 
NOTE_ON = 0x90;
NOTE_OFF = 0x80;
gfx_clear = 30 + (30 * 256) + (34 * 65536); 

valid_notes = 1000;      
active_notes = 2000;     
TEMP_CHORD_BUF = 3000;   
MAX_ACTIVE_NOTES = 128;  

w_states = 9000; 
b_states = 9010;

VIS_BUF = 10000;
MAX_VIS = 256;
vis_head = 0;
vis_count = 0;

valid_count = 0;
phase = 0;
last_play_state = play_state;
last_chord_mode = -1; 
sys_active_count = 0; 
last_scale_preset = -1;
gui_click_handled = 0;

// Integer Grid Engine variables
last_beat = -999.0;
last_grid_step = -999;

function clear_active_notes(offset) local(i) (
    i = 0;
    while(i < MAX_ACTIVE_NOTES) (
        active_notes[i*3 + 2] > 0 ? (
            midisend(offset, NOTE_OFF, active_notes[i*3], 0);
            active_notes[i*3 + 2] = 0;
        );
        i += 1;
    );
    sys_active_count = 0;
);

function apply_preset(preset) (
    preset == 1 ? ( slider10=1; slider11=1; slider12=1; slider13=1; slider14=1; slider15=1; slider16=1; slider17=1; slider18=1; slider19=1; slider20=1; slider21=1; ) : 
    preset == 2 ? ( slider10=1; slider11=0; slider12=1; slider13=0; slider14=1; slider15=1; slider16=0; slider17=1; slider18=0; slider19=1; slider20=0; slider21=1; ) : 
    preset == 3 ? ( slider10=1; slider11=0; slider12=1; slider13=1; slider14=0; slider15=1; slider16=0; slider17=1; slider18=1; slider19=0; slider20=1; slider21=0; ) : 
    preset == 4 ? ( slider10=1; slider11=0; slider12=1; slider13=0; slider14=1; slider15=0; slider16=0; slider17=1; slider18=0; slider19=1; slider20=0; slider21=0; ) : 
    preset == 5 ? ( slider10=1; slider11=0; slider12=0; slider13=1; slider14=0; slider15=1; slider16=0; slider17=1; slider18=0; slider19=0; slider20=1; slider21=0; ) : 
    preset == 6 ? ( slider10=1; slider11=0; slider12=1; slider13=1; slider14=0; slider15=1; slider16=0; slider17=1; slider18=0; slider19=1; slider20=1; slider21=0; ) : 
    preset == 7 ? ( slider10=1; slider11=1; slider12=0; slider13=1; slider14=0; slider15=1; slider16=0; slider17=1; slider18=1; slider19=0; slider20=1; slider21=0; ) : 
    preset == 8 ? ( slider10=1; slider11=0; slider12=1; slider13=0; slider14=1; slider15=0; slider16=1; slider17=1; slider18=0; slider19=1; slider20=0; slider21=1; ) : 
    preset == 9 ? ( slider10=1; slider11=0; slider12=1; slider13=0; slider14=1; slider15=1; slider16=0; slider17=1; slider18=0; slider19=1; slider20=1; slider21=0; ) : 
    preset == 10 ? ( slider10=1; slider11=1; slider12=0; slider13=1; slider14=0; slider15=1; slider16=1; slider17=0; slider18=1; slider19=0; slider20=1; slider21=0; ) : 
    preset == 11 ? ( slider10=1; slider11=0; slider12=1; slider13=1; slider14=0; slider15=1; slider16=0; slider17=1; slider18=1; slider19=0; slider20=0; slider21=1; ) : 
    preset == 12 ? ( slider10=1; slider11=0; slider12=1; slider13=1; slider14=0; slider15=1; slider16=0; slider17=1; slider18=0; slider19=1; slider20=0; slider21=1; );   
);

function build_quantizer_pool() local(n, note_class, is_active) (
    valid_count = 0;
    slider4 > slider5 ? ( temp = slider4; slider4 = slider5; slider5 = temp; );
    
    n = slider4;
    while(n <= slider5) (
        note_class = n % 12;
        is_active = 0;
        note_class == 0 ? is_active = slider10 : note_class == 1 ? is_active = slider11 : note_class == 2 ? is_active = slider12 :
        note_class == 3 ? is_active = slider13 : note_class == 4 ? is_active = slider14 : note_class == 5 ? is_active = slider15 :
        note_class == 6 ? is_active = slider16 : note_class == 7 ? is_active = slider17 : note_class == 8 ? is_active = slider18 :
        note_class == 9 ? is_active = slider19 : note_class == 10 ? is_active = slider20 : note_class == 11 ? is_active = slider21;
        
        is_active ? ( valid_notes[valid_count] = n; valid_count += 1; );
        n += 1;
    );
);

function generate_note(offset_samples, calc_len, proj_time) local(base_vel, num_notes, picks, k, target_idx, is_dup, c, final_note, chord_vel, i, inserted, j, attempts) (
    valid_count > 0 ? (
        base_vel = 60 + (rand(47)|0); 
        num_notes = slider9 == 1 ? slider22 : 1;
        
        picks = num_notes;
        picks > valid_count ? picks = valid_count;
        
        k = 0;
        while(k < picks) (
            // Robust Rejection Sampling with infinite-loop failsafe
            is_dup = 1;
            attempts = 0;
            while(is_dup && attempts < 100) (
                target_idx = rand(valid_count)|0;
                is_dup = 0;
                c = 0;
                while(c < k) (
                    TEMP_CHORD_BUF[c] == target_idx ? is_dup = 1;
                    c += 1;
                );
                attempts += 1;
            );
            TEMP_CHORD_BUF[k] = target_idx;
            
            final_note = valid_notes[target_idx] + slider6; 
            
            final_note >= 0 && final_note <= 127 ? (
                // SURGICAL KILL: Ensure this specific pitch is absolutely dead before sending a new NOTE_ON
                j = 0;
                while(j < MAX_ACTIVE_NOTES) (
                    active_notes[j*3 + 2] > 0 && active_notes[j*3] == final_note ? (
                        midisend(offset_samples, NOTE_OFF, final_note, 0);
                        active_notes[j*3 + 2] = 0; 
                        sys_active_count -= 1;
                    );
                    j += 1;
                );

                chord_vel = base_vel + (rand(10)|0) - 5;
                chord_vel > 127 ? chord_vel = 127; chord_vel < 1 ? chord_vel = 1;
                
                midisend(offset_samples, NOTE_ON, final_note, chord_vel);
                
                i = 0; inserted = 0;
                while(i < MAX_ACTIVE_NOTES && !inserted) (
                    active_notes[i*3 + 2] <= 0 ? (
                        active_notes[i*3] = final_note;
                        active_notes[i*3 + 1] = chord_vel;
                        active_notes[i*3 + 2] = calc_len;
                        inserted = 1;
                        sys_active_count += 1;
                        
                        // Push cleanly to visualizer
                        VIS_BUF[vis_head*4 + 0] = final_note;
                        VIS_BUF[vis_head*4 + 1] = proj_time;
                        VIS_BUF[vis_head*4 + 2] = calc_len / srate; 
                        VIS_BUF[vis_head*4 + 3] = chord_vel;
                        
                        vis_head = (vis_head + 1) % MAX_VIS;
                        vis_count < MAX_VIS ? vis_count += 1;
                    );
                    i += 1;
                );
            );
            k += 1;
        );
    );
);

@slider
slider8 != last_scale_preset ? (
    apply_preset(slider8);
    last_scale_preset = slider8;
);

slider9 != last_chord_mode ? (
    slider_show(slider22, slider9 == 1);
    last_chord_mode = slider9;
);

build_quantizer_pool();

@block
while(midirecv(offset, msg1, msg2, msg3)) ( midisend(offset, msg1, msg2, msg3); );

tempo > 0 ? current_bpm = tempo : current_bpm = 120;

slider1 == 0 ? ( 
    samples_per_cycle = (slider3 / 1000.0) * srate;
) : ( 
    slider2 == 0 ? beat_step = 32.0 : slider2 == 1 ? beat_step = 16.0 : 
    slider2 == 2 ? beat_step = 8.0  : slider2 == 3 ? beat_step = 4.0  : 
    slider2 == 4 ? beat_step = 2.0  : slider2 == 5 ? beat_step = 1.0  : 
    slider2 == 6 ? beat_step = 0.5  : slider2 == 7 ? beat_step = 0.25 : 
    slider2 == 8 ? beat_step = 0.125: slider2 == 9 ? beat_step = 1.0*(2/3) : 
    slider2 == 10 ? beat_step = 0.5*(2/3) : beat_step = 0.25*(2/3);  
    samples_per_cycle = (beat_step * 60.0 / current_bpm) * srate;
);

is_playing = play_state & 1;
is_playing != last_is_playing ? (
    !is_playing ? (
        clear_active_notes(0);
        
        // STOPPED: Instantly Truncate Visualizer Notes so they don't overhang the playhead
        v = 0;
        while(v < MAX_VIS) (
            VIS_BUF[v*4 + 1] + VIS_BUF[v*4 + 2] > last_stop_time ? (
                VIS_BUF[v*4 + 2] = max(0, last_stop_time - VIS_BUF[v*4 + 1]);
            );
            v += 1;
        );
    ) : (
        // Reset Logic for clean start
        last_beat = -999.0;
        phase = samples_per_cycle; 
    );
    last_is_playing = is_playing;
);

is_playing > 0 ? (
    s = 0;
    while(s < samplesblock) (
        proj_time = play_position + (s / srate);
        
        // Cleanly decrement currently playing note gates
        i = 0; checked = 0; curr_sys = sys_active_count; 
        while(i < MAX_ACTIVE_NOTES && checked < curr_sys) (
            active_notes[i*3 + 2] > 0 ? (
                checked += 1;
                active_notes[i*3 + 2] -= 1;
                active_notes[i*3 + 2] <= 0 ? ( 
                    midisend(s, NOTE_OFF, active_notes[i*3], 0);
                    active_notes[i*3 + 2] = 0;
                    sys_active_count -= 1;
                );
            );
            i += 1;
        );
        
        trigger = 0;
        slider1 == 1 ? (
            current_beat = beat_position + (s / srate) * (current_bpm / 60.0);
            
            // JITTER-PROOF INTEGER GRID TRACKING
            adj_beat = current_beat + 0.0001; 
            
            // Detect Jumps / Loops
            abs(current_beat - last_beat) > 0.1 ? (
                // Force the next integer evaluation to trigger instantly
                last_grid_step = floor(adj_beat / beat_step) - 1; 
                clear_active_notes(s);
                vis_count = 0; vis_head = 0; 
            );
            
            curr_grid_step = floor(adj_beat / beat_step);
            
            curr_grid_step > last_grid_step ? (
                trigger = 1;
                last_grid_step = curr_grid_step;
            );
            
            last_beat = current_beat;
            calc_len = (beat_step * (60.0 / current_bpm) * srate * (slider7 / 100.0))|0;
        ) : (
            // FREE RATE 
            phase += 1;
            phase >= samples_per_cycle ? (
                phase -= samples_per_cycle; 
                trigger = 1;
            );
            calc_len = (samples_per_cycle * (slider7 / 100.0))|0;
        );

        trigger ? (
            cycle_len = slider1 == 1 ? (beat_step * (60.0 / current_bpm) * srate)|0 : samples_per_cycle|0;
            calc_len >= cycle_len ? calc_len = cycle_len - 1; 
            calc_len < 1 ? calc_len = 1;
            generate_note(s, calc_len, proj_time);
        );

        s += 1;
    );
    last_stop_time = play_position + (samplesblock / srate);
);


@gfx 600 480
// Thread-safe UI snapshotting
safe_vis_head = vis_head;
safe_vis_count = vis_count;

gfx_setfont(1, "Arial", 16, 'b');
gfx_setfont(2, "Arial", 12);
gfx_setfont(3, "Arial", 24, 'b');
gfx_setfont(4, "Arial", 11, 'b'); 

gfx_set(0.2, 0.6, 1.0, 1.0);
gfx_x = 20; gfx_y = 15;
gfx_setfont(3);
gfx_drawstr("RAQUD ");
gfx_setfont(1);
gfx_set(0.6, 0.6, 0.6, 1.0);
gfx_drawstr(" Random MIDI Generator");

key_w = 30;
key_h = 100;
start_x = 20;
start_y = 60;

function draw_white_key(id, x, y, active) (
    active ? gfx_set(0.8, 0.9, 1.0, 1.0) : gfx_set(0.4, 0.4, 0.4, 1.0);
    gfx_rect(x, y, key_w - 1, key_h);
    gfx_set(0.1, 0.1, 0.1, 1.0);
    gfx_rect(x, y, key_w - 1, key_h, 0); 
);

function draw_black_key(id, x, y, active) local(bw, bh) (
    bw = key_w * 0.6;
    bh = key_h * 0.6;
    active ? gfx_set(0.2, 0.5, 0.8, 1.0) : gfx_set(0.05, 0.05, 0.05, 1.0);
    gfx_rect(x - bw/2, y, bw, bh);
    gfx_set(0.0, 0.0, 0.0, 1.0);
    gfx_rect(x - bw/2, y, bw, bh, 0); 
);

w_states[0] = slider10; w_states[1] = slider12; w_states[2] = slider14; w_states[3] = slider15; 
w_states[4] = slider17; w_states[5] = slider19; w_states[6] = slider21; 
b_states[0] = slider11; b_states[1] = slider13; b_states[2] = slider16; b_states[3] = slider18; b_states[4] = slider20;

i = 0;
while(i < 7) (
    draw_white_key(i, start_x + (i * key_w), start_y, w_states[i]);
    i += 1;
);

draw_black_key(0, start_x + key_w, start_y, b_states[0]);
draw_black_key(1, start_x + key_w*2, start_y, b_states[1]);
draw_black_key(2, start_x + key_w*4, start_y, b_states[2]);
draw_black_key(3, start_x + key_w*5, start_y, b_states[3]);
draw_black_key(4, start_x + key_w*6, start_y, b_states[4]);

mouse_cap & 1 && !gui_click_handled ? (
    mx = mouse_x; my = mouse_y;
    
    mx >= start_x && mx <= start_x + (7*key_w) && my >= start_y && my <= start_y + key_h ? (
        clicked_slider = -1;
        
        my <= start_y + (key_h*0.6) ? (
            bx1 = start_x + key_w; mx >= bx1 - 9 && mx <= bx1 + 9 ? clicked_slider = 11;
            bx2 = start_x + key_w*2; mx >= bx2 - 9 && mx <= bx2 + 9 ? clicked_slider = 13;
            bx3 = start_x + key_w*4; mx >= bx3 - 9 && mx <= bx3 + 9 ? clicked_slider = 16;
            bx4 = start_x + key_w*5; mx >= bx4 - 9 && mx <= bx4 + 9 ? clicked_slider = 18;
            bx5 = start_x + key_w*6; mx >= bx5 - 9 && mx <= bx5 + 9 ? clicked_slider = 20;
        );
        
        clicked_slider == -1 ? (
            idx = ((mx - start_x) / key_w)|0;
            idx == 0 ? clicked_slider = 10 : idx == 1 ? clicked_slider = 12 : idx == 2 ? clicked_slider = 14 :
            idx == 3 ? clicked_slider = 15 : idx == 4 ? clicked_slider = 17 : idx == 5 ? clicked_slider = 19 :
            idx == 6 ? clicked_slider = 21;
        );
        
        clicked_slider != -1 ? (
            clicked_slider == 10 ? slider10 = 1 - slider10 : clicked_slider == 11 ? slider11 = 1 - slider11 :
            clicked_slider == 12 ? slider12 = 1 - slider12 : clicked_slider == 13 ? slider13 = 1 - slider13 :
            clicked_slider == 14 ? slider14 = 1 - slider14 : clicked_slider == 15 ? slider15 = 1 - slider15 :
            clicked_slider == 16 ? slider16 = 1 - slider16 : clicked_slider == 17 ? slider17 = 1 - slider17 :
            clicked_slider == 18 ? slider18 = 1 - slider18 : clicked_slider == 19 ? slider19 = 1 - slider19 :
            clicked_slider == 20 ? slider20 = 1 - slider20 : clicked_slider == 21 ? slider21 = 1 - slider21;
            
            slider8 = 0; 
            sliderchange(slider8);
            sliderchange(clicked_slider);
            build_quantizer_pool(); 
        );
    );
    gui_click_handled = 1;
);
!(mouse_cap & 1) ? gui_click_handled = 0;

gfx_setfont(2);
gfx_set(0.6, 0.6, 0.6, 1.0);

gfx_x = 20; gfx_y = start_y + key_h + 15;
gfx_drawstr("Click keys to toggle scale quantization.");

gfx_x = 20; gfx_y = start_y + key_h + 35;
gfx_set(0.8, 0.8, 0.8, 1.0);
gfx_printf("Valid pool: %d notes in range.", valid_count);

gfx_x = 260; gfx_y = 60;
gfx_set(0.2, 0.6, 1.0, 1.0);
gfx_drawstr("Timing Mode: ");
gfx_set(0.9, 0.9, 0.9, 1.0);
slider1 == 1 ? gfx_drawstr("SYNC") : gfx_drawstr("FREE");

gfx_x = 260; gfx_y = 80;
gfx_set(0.2, 0.6, 1.0, 1.0);
gfx_drawstr("Chord Mode: ");
gfx_set(0.9, 0.9, 0.9, 1.0);
slider9 == 1 ? gfx_printf("ON (%d Notes)", slider22) : gfx_drawstr("OFF");

gfx_x = 260; gfx_y = 100;
gfx_set(0.5, 0.5, 0.5, 1.0);
gfx_drawstr("Voices: ");
gfx_set(0.2, 0.8, 0.2, 1.0);
gfx_printf("%d / %d", sys_active_count, MAX_ACTIVE_NOTES);

!(play_state & 1) ? (
    gfx_x = 260; gfx_y = 135;
    gfx_set(1.0, 0.3, 0.3, 1.0);
    gfx_drawstr("[TRANSPORT STOPPED]");
);

// === DAW STYLE SLIDING TIMELINE VISUALIZER ===
tx = 20; 
ty = 230; 
tw = gfx_w - 40; 
th = gfx_h - ty - 20;

view_window_s = slider1 == 1 ? (120.0 / current_bpm) * 2.0 : 3.0; 
t_playhead = (play_state & 1) ? play_position : last_stop_time;
t_start = t_playhead - (view_window_s * 0.85);
t_end = t_playhead + (view_window_s * 0.15);

p_min_base = slider4 < slider5 ? slider4 : slider5;
p_max_base = slider4 > slider5 ? slider4 : slider5;
p_min = max(0, min(127, p_min_base + slider6));
p_max = max(0, min(127, p_max_base + slider6));

i = 0;
while(i < safe_vis_count) (
    idx = safe_vis_head - 1 - i;
    idx < 0 ? idx += MAX_VIS;
    
    pitch = VIS_BUF[idx*4 + 0];
    start_s = VIS_BUF[idx*4 + 1];
    len_s = VIS_BUF[idx*4 + 2];
    
    start_s + len_s >= t_start && start_s <= t_end ? (
        pitch < p_min ? p_min = pitch;
        pitch > p_max ? p_max = pitch;
    );
    i += 1;
);

p_min -= 1;
p_max += 1;
p_range = p_max - p_min + 1;

p_range < 14 ? ( 
    mid = (p_min + p_max) / 2;
    p_min = (mid - 7)|0;
    p_max = (mid + 7)|0;
);

p_min < 0 ? p_min = 0;
p_max > 127 ? p_max = 127;
p_range = p_max - p_min + 1;
row_h = th / max(1, p_range);

gfx_set(0.14, 0.14, 0.14, 1.0);
gfx_rect(tx, ty, tw, th);

gfx_set(0.2, 0.2, 0.2, 1.0);
grid_step_s = slider1 == 1 ? (beat_step * 60.0 / current_bpm) : (slider3 / 1000.0);
grid_step_s < 0.05 ? grid_step_s = 0.05; 
div = t_start / grid_step_s;
first_line = (floor(div) + 1) * grid_step_s;
g_s = first_line;
while(g_s <= t_end) (
    gx = tx + ((g_s - t_start) / view_window_s) * tw;
    gx >= tx && gx <= tx + tw ? gfx_line(gx, ty, gx, ty + th);
    g_s += grid_step_s;
);

gfx_set(0.2, 0.2, 0.2, 0.5);
r = 0;
while(r <= p_range) (
    ry = ty + r * row_h;
    gfx_line(tx, ry, tx + tw, ry);
    r += 1;
);

gfx_set(0.3, 0.3, 0.3, 1.0);
gfx_rect(tx, ty, tw, th, 0);

i = 0;
while(i < safe_vis_count) (
    idx = safe_vis_head - 1 - i;
    idx < 0 ? idx += MAX_VIS;
    
    pitch = VIS_BUF[idx*4 + 0];
    start_s = VIS_BUF[idx*4 + 1];
    len_s = VIS_BUF[idx*4 + 2];
    vel = VIS_BUF[idx*4 + 3];
    
    nx = tx + ((start_s - t_start) / view_window_s) * tw;
    nw = (len_s / view_window_s) * tw;
    
    draw_x = max(tx, nx);
    draw_r = min(tx + tw, nx + nw);
    draw_w = draw_r - draw_x;
    
    ny = ty + th - ((pitch - p_min + 1) * row_h);
    nh = row_h;
    
    draw_w > 0 && pitch >= p_min && pitch <= p_max ? (
        is_active = (play_state & 1) && (t_playhead >= start_s && t_playhead <= start_s + len_s);
        
        is_active ? gfx_set(0.3, 0.7, 1.0, 1.0) : gfx_set(0.15, 0.4, 0.6, 0.8);
        vel_alpha = 0.5 + (vel / 127.0) * 0.5;
        is_active ? gfx_a = 1.0 : gfx_a = vel_alpha;
        
        gfx_rect(draw_x, ny, draw_w, nh);
        
        gfx_set(0.05, 0.1, 0.2, 1.0);
        gfx_rect(draw_x, ny, draw_w, nh, 0);
        
        oct = (pitch / 12)|0 - 1;
        n_idx = pitch % 12;
        n_idx == 0 ? n_str = "C" : n_idx == 1 ? n_str = "C#" : n_idx == 2 ? n_str = "D" :
        n_idx == 3 ? n_str = "D#" : n_idx == 4 ? n_str = "E" : n_idx == 5 ? n_str = "F" :
        n_idx == 6 ? n_str = "F#" : n_idx == 7 ? n_str = "G" : n_idx == 8 ? n_str = "G#" :
        n_idx == 9 ? n_str = "A" : n_idx == 10 ? n_str = "A#" : n_str = "B";
        sprintf(#note_label, "%s%d", n_str, oct);
        
        gfx_setfont(4); 
        gfx_measurestr(#note_label, str_w, str_h);
        
        nh >= 10 && draw_w >= 8 ? (
            gfx_x = draw_x + 2;
            gfx_y = ny + (nh - str_h)/2;
            gfx_set(0.0, 0.0, 0.0, 0.9);
            gfx_drawstr(#note_label);
        );
    );
    i += 1;
);

playhead_x = tx + (tw * 0.85);
play_state & 1 ? gfx_set(1.0, 0.8, 0.2, 0.9) : gfx_set(0.5, 0.5, 0.5, 0.5);
gfx_line(playhead_x, ty, playhead_x, ty + th);
gfx_triangle(playhead_x - 5, ty - 5, playhead_x + 5, ty - 5, playhead_x, ty);
